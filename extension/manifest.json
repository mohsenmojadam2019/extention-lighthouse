{
  "manifest_version": 3,
  "name": "Lighthouse Pro | تحلیل تخصصی سایت",
  "version": "1.0.0",
  "description": "ممیزی واقعی Lighthouse با گزارش سرعت، Core Web Vitals آزمایشگاهی، سئو، دسترس‌پذیری و مشکلات فنی.",
  "action": {
    "default_title": "Lighthouse Pro — تحلیل صفحه"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:4177/*"
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}